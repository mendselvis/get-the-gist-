# Which provider runs first: otari | anthropic | gemini | groq
LLM_PROVIDER=otari

# Otari AI gateway
OTARI_API_KEY=
OTARI_MODEL=z-ai/glm-5.3-flash
OTARI_FALLBACK_MODEL=mistralai/ministral-3-8b

# Follow-up chat ("Ask about this slide"), a separate open-weight model
OTARI_CHAT_MODEL=mistralai/ministral-3-8b

# Checks solved answers by running code in Otari's sandbox (defaults to OTARI_MODEL)
OTARI_CODE_MODEL=

# Optional fallback providers, tried after Otari only when their key is set.
# None are needed: the app runs with the Otari variables alone.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
